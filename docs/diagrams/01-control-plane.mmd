flowchart TB
  subgraph TRUST["1 · Establish trusted<br/>customer state"]
    direction LR
    Sources["CRM · Consent · Privacy · Scoring"] --> Identity["Canonical identity<br/>Reviewed source links"]
    Identity --> Truth["Source authority<br/>Sequence · No-Regress"]
    Truth --> State[("Durable customer state<br/>Provenance · Audit")]
  end
  subgraph GOVERN["2 · Authorize proposed action"]
    direction LR
    Agent["Agent / workflow proposals"] --> Gate["Current policy<br/>Consent · Approval"]
    Gate --> Work[("Durable intent<br/>Leases")]
  end
  subgraph EXEC["3 · Execute and reconcile effects"]
    direction LR
    Worker["Executor rechecks<br/>current authority"] -->|"Stable effect ID"| Effects[("Remote effect<br/>+ receipt")]
    Effects --> Reconcile["Unknown outcome?<br/>Look up original receipt<br/>before any retry"]
  end
  TRUST -->|"Trusted customer state + source versions"| GOVERN
  GOVERN -->|"Committed work + approval context"| EXEC
  classDef durable fill:#2A2A3D,stroke:#B8B8FF,color:#F0F0FF,stroke-width:1.8px
  classDef control fill:#2E2E45,stroke:#7C7CAF,color:#F0F0FF,stroke-width:1.5px
  class State,Work,Effects durable
  class Truth,Gate,Worker,Reconcile control
  style TRUST fill:#181825,stroke:#7C7CAF,color:#F0F0FF,stroke-width:1.2px
  style GOVERN fill:#181825,stroke:#7C7CAF,color:#F0F0FF,stroke-width:1.2px
