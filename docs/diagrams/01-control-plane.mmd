flowchart LR
  Sources["CRM · Consent · Privacy · Scoring"] --> Identity["Canonical identity<br/>Reviewed source links"]
  Identity --> Truth["Authority · Sequence · No-Regress"]
  Truth --> State[("Customer state<br/>Provenance · Audit")]
  Agent["AI / workflow proposals"] --> Gate["Policy · Consent · Approval"]
  State --> Gate
  Gate --> Work[("Durable intent and leases")]
  Work --> Worker["Executor rechecks authority"]
  Worker -->|"Stable effect identity"| Effects[("Downstream effect + receipt")]
  Effects -->|"Reconcile unknown outcome"| Work
