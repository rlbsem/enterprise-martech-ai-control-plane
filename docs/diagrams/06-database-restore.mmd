flowchart TD
  Incident["Control database recovery required"] --> Freeze["Quiesce admission, workers and downstream<br/>Verify no running tasks"]
  Freeze --> Restore["PITR into NEW control instance<br/>Retain original; keep downstream intact"]
  Restore --> Bind["Review Terraform endpoint binding<br/>Bootstrap secret DSNs and role grants"]
  Bind --> Compare["Read-only verifier compares ALL intents and receipts"]
  Compare --> Result{"Any missing intent, hash mismatch<br/>or missing acknowledged receipt?"}
  Result -->|Yes| Hold["Remain closed<br/>Recover ledger / investigate incident"]
  Result -->|No| Proof["Fresh comparison immediately before resume"]
  Proof --> Resume["Start downstream, API, workers, observer<br/>Recheck health and exact revision"]
  Resume --> Reconcile["Workers reconcile existing uncertain keys<br/>Revalidate before any new dispatch"]
  classDef stage fill:#2A2A3D,stroke:#B8B8FF,color:#F0F0FF,stroke-width:1.6px
  classDef gate fill:#2E2E45,stroke:#E3BC7F,color:#F0F0FF,stroke-width:2px
  classDef hold fill:#2E2E45,stroke:#D98EA3,color:#F0F0FF,stroke-width:2px
  classDef release fill:#2E2E45,stroke:#81C5B0,color:#F0F0FF,stroke-width:2px
  class Incident,Freeze,Restore,Bind,Compare stage
  class Result,Proof gate
  class Hold hold
  class Resume,Reconcile release
